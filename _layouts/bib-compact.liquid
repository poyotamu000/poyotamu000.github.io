---
---
{% assign proceedings = 'inproceedings,incollection' | split: ',' %}
{% assign theses = 'thesis,mastersthesis,phdthesis' | split: ',' %}
{% assign self_first_romanized = 'Akihiro' %}
{% assign self_last_romanized = 'Miki' %}
{% assign self_first_japanese = '章寛' %}
{% assign self_last_japanese = '三木' %}

{% capture venue %}
  {% if entry.type == 'article' %}
    {{ entry.journal }}
  {% elsif proceedings contains entry.type %}
    {{ entry.booktitle }}
  {% elsif theses contains entry.type %}
    {{ entry.school }}
  {% else %}
    {{ entry.publisher }}
  {% endif %}
{% endcapture %}

{% assign link_count = 0 %}

<span class="pub-authors">
  {% for author in entry.author_array %}
    {% assign author_name = '' %}
    {% assign author_class = '' %}

    {% if author.first == self_first_romanized and author.last == self_last_romanized %}
      {% assign author_name = 'AKIHIRO MIKI' %}
      {% assign author_class = 'self-author self-author-romanized' %}
    {% elsif author.first == self_first_japanese and author.last == self_last_japanese %}
      {% assign author_name = self_last_japanese | append: ' ' | append: self_first_japanese %}
      {% assign author_class = 'self-author self-author-japanese' %}
    {% elsif author.first == self_last_japanese and author.last == self_first_japanese %}
      {% assign author_name = self_first_japanese | append: ' ' | append: self_last_japanese %}
      {% assign author_class = 'self-author self-author-japanese' %}
    {% else %}
      {% assign author_name = author.first | append: ' ' | append: author.last %}
    {% endif %}

    <span class="{{ author_class }}">{{ author_name }}</span>
    {%- unless forloop.last %}, {% endunless %}
  {% endfor %}
</span>
"<span class="pub-title">{{ entry.title }}</span>", in <em>{{ venue | strip }}</em>
{%- if entry.year %}, {{ entry.year }}{% endif -%}
{%- if entry.volume %}, vol. {{ entry.volume }}{% endif -%}
{%- if entry.number %}, no. {{ entry.number }}{% endif -%}
{%- if entry.pages %}, pp. {{ entry.pages }}{% endif -%}
{%- if entry.note %}, {{ entry.note }}{% endif %}.

{% if entry.arxiv or entry.website or entry.html or entry.doi or entry.pdf or entry.video or entry.code %}
  [
  {% if entry.arxiv %}
    <a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.website %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="{{ entry.website }}">website</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.html %}
    {% if link_count > 0 %} | {% endif %}
    {% if entry.html contains '://' %}
      <a href="{{ entry.html }}">page</a>
    {% else %}
      <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}">page</a>
    {% endif %}
    {% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.doi %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="https://doi.org/{{ entry.doi }}">paper</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.pdf %}
    {% if link_count > 0 %} | {% endif %}
    {% if entry.pdf contains '://' %}
      <a href="{{ entry.pdf }}">paper</a>
    {% else %}
      <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">paper</a>
    {% endif %}
    {% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.video %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="{{ entry.video }}">video</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.code %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="{{ entry.code }}">code</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  ]
{% endif %}
