---
---
{% assign proceedings = 'inproceedings,incollection' | split: ',' %}
{% assign theses = 'thesis,mastersthesis,phdthesis' | split: ',' %}
{% assign self_first_romanized = 'Akihiro' %}
{% assign self_last_romanized = 'Miki' %}
{% assign self_first_japanese = '章寛' %}
{% assign self_last_japanese = '三木' %}

{% capture venue %}
  {% if entry.type == 'article' %}
    {{ entry.journal }}
  {% elsif proceedings contains entry.type %}
    {{ entry.booktitle }}
  {% elsif theses contains entry.type %}
    {{ entry.school }}
  {% else %}
    {{ entry.publisher }}
  {% endif %}
{% endcapture %}

{% assign link_count = 0 %}
{% assign doi_value = entry.doi | default: '' | strip %}
{% assign has_doi = false %}
{% if doi_value != '' %}
  {% assign has_doi = true %}
{% endif %}

<span class="pub-authors">
  {% for author in entry.author_array %}
    {% assign author_name = '' %}
    {% assign author_class = '' %}
    {% assign author_first = author.first | strip %}
    {% assign author_last = author.last | strip %}
    {% assign first_non_japanese = author_first | regex_replace: '[ぁ-んァ-ヶ一-龠々ー・]', '' %}
    {% assign last_non_japanese = author_last | regex_replace: '[ぁ-んァ-ヶ一-龠々ー・]', '' %}
    {% assign is_japanese_name = false %}
    {% if first_non_japanese != author_first or last_non_japanese != author_last %}
      {% assign is_japanese_name = true %}
    {% endif %}

    {% if is_japanese_name %}
      {% assign author_name = author_last | append: ' ' | append: author_first %}
    {% else %}
      {% assign author_name = author_first | append: ' ' | append: author_last %}
    {% endif %}

    {% if author_first == self_first_romanized and author_last == self_last_romanized %}
      {% assign author_class = 'self-author' %}
    {% elsif author_first == self_first_japanese and author_last == self_last_japanese %}
      {% assign author_class = 'self-author' %}
    {% elsif author_first == self_last_japanese and author_last == self_first_japanese %}
      {% assign author_class = 'self-author' %}
    {% endif %}

    <span class="{{ author_class }}">{{ author_name }}</span>
    {%- unless forloop.last %}, {% endunless %}
  {% endfor %}
</span>
"<span class="pub-title">{{ entry.title }}</span>", in <em>{{ venue | strip }}</em>
{%- if entry.volume %}, vol. {{ entry.volume }}{% endif -%}
{%- if entry.number %}, no. {{ entry.number }}{% endif -%}
{%- if entry.pages -%}
  {%- if entry.pubtype == 'domestic_conference' -%}
    , {{ entry.pages }}
  {%- else -%}
    , pp. {{ entry.pages }}
  {%- endif -%}
{%- endif -%}
{%- if entry.note %}, {{ entry.note }}{% endif -%}
{%- if entry.year %}, {{ entry.year }}{% endif %}.

{% if entry.arxiv or entry.website or entry.html or has_doi or entry.pdf or entry.video or entry.code %}
  [
  {% if entry.arxiv %}
    <a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.website %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="{{ entry.website }}">website</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.html %}
    {% if link_count > 0 %} | {% endif %}
    {% if entry.html contains '://' %}
      <a href="{{ entry.html }}">page</a>
    {% else %}
      <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}">page</a>
    {% endif %}
    {% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if has_doi %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="https://doi.org/{{ doi_value }}">paper</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.pdf %}
    {% if link_count > 0 %} | {% endif %}
    {% if entry.pdf contains '://' %}
      <a href="{{ entry.pdf }}">pdf</a>
    {% else %}
      <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">pdf</a>
    {% endif %}
    {% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.video %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="{{ entry.video }}">video</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  {% if entry.code %}
    {% if link_count > 0 %} | {% endif -%}
    <a href="{{ entry.code }}">code</a>{% assign link_count = link_count | plus: 1 %}
  {% endif %}
  ]
{% endif %}
